  "id": null,
  "uid": "factory-quality-insights",
  "title": "Симулятор: качество и брак",
  "tags": ["factory", "quality", "vkr"],
  "timezone": "browser",
  "weekStart": "monday",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "templating": {"list": []},
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "Брак за день",
      "description": "Число бракованных измерений за последние сутки ВИРТУАЛЬНОГО времени (якорь — MAX(measured_at), т.к. время симулятора, не реальное).",
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "red"},
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS fails FROM measurements WHERE result='fail' AND measured_at >= (SELECT MAX(measured_at) FROM measurements) - INTERVAL '1 day'"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Доля брака",
      "description": "Процент брака от всех измерений (за всё время).",
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 20,
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 5},
            {"color": "red", "value": 12}
          ]}
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE result='fail') / NULLIF(count(*), 0), 1) AS value FROM measurements"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pass / Fail (всё время)",
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "pass"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}
          ]},
          {"matcher": {"id": "byName", "options": "fail"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}
          ]}
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE result='pass') AS pass, count(*) FILTER (WHERE result='fail') AS fail FROM measurements"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Открытых нарядов",
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 2},
            {"color": "red", "value": 5}
          ]},
          "unit": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM open_work_orders"
        }
      ]
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Причины брака",
      "description": "Сколько брака даёт каждая причина (название сценария или фоновый брак), за всё время.",
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]},
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": true},
        "tooltip": {"mode": "single"}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT reason AS metric, count(*) AS value FROM measurements WHERE result='fail' AND reason IS NOT NULL GROUP BY reason ORDER BY value DESC"
        }
      ]
    },
    {
      "id": 21,
      "type": "barchart",
      "title": "Брак по станкам-виновникам",
      "description": "Какой станок породил больше всего брака (source_machine_id, за всё время). Видно главный источник.",
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "xField": "Станок",
        "tooltip": {"mode": "single"},
        "legend": {"showLegend": false}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "continuous-YlRd"},
          "unit": "short",
          "custom": {"fillOpacity": 90, "lineWidth": 1, "axisLabel": "брак, шт"}
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source_machine_id AS \"Станок\", count(*) AS \"Брак\" FROM measurements WHERE result='fail' AND source_machine_id IS NOT NULL GROUP BY source_machine_id ORDER BY count(*) DESC"
        }
      ]
    },
    {
      "id": 20,
      "type": "barchart",
      "title": "Pass / Fail по этапам",
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 14},
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "showValue": "auto",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "tooltip": {"mode": "single"},
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {"matcher": {"id": "byName", "options": "pass"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}
          ]},
          {"matcher": {"id": "byName", "options": "fail"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}
          ]}
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT stage, count(*) FILTER (WHERE result='pass') AS pass, count(*) FILTER (WHERE result='fail') AS fail FROM measurements GROUP BY stage ORDER BY CASE stage WHEN 'turning' THEN 1 WHEN 'hobbing' THEN 2 WHEN 'shaving' THEN 3 WHEN 'heat_treatment' THEN 4 WHEN 'grinding' THEN 5 ELSE 6 END"
        }
      ]
    },
    {
      "id": 30,
      "type": "table",
      "title": "Последние 15 фейлов",
      "description": "Самые свежие бракованные измерения. Видно: что мерили, какое значение, какая причина.",
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 14},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}},
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "filterable": false}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Причина"}, "properties": [
            {"id": "custom.cellOptions", "value": {"type": "color-text"}}
          ]}
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT measured_at AS \"Время\", batch_id AS \"Партия\", stage AS \"Этап\", parameter AS \"Параметр\", ROUND(value::numeric, 2) AS \"Значение\", reason AS \"Причина\", COALESCE(source_machine_id, '—') AS \"Виновник\" FROM measurements WHERE result='fail' ORDER BY measured_at DESC LIMIT 15"
        }
      ]
    }
  ]
}
